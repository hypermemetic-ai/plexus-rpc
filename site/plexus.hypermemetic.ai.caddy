# plexus.hypermemetic.ai — Plexus RPC's page (PLEXUS-56, PLEXUS-61), served
# by the edge.
#
# Deployed by hypermemetic-infra's edge role, which copies plexus-rpc's
# site/ (index.html, style.css, main.js, favicon.svg, fonts/, media/) to
# /srv/plexus.hypermemetic.ai and this file into the edge's sites/, from a
# pinned commit. Not deployed by hand.
#
# The page makes no request beyond its own files and has no inline script
# or style, so the policy needs no hash and no 'unsafe-inline'. The web is
# drawn in WebGL by main.js; nothing connects anywhere.

plexus.hypermemetic.ai {
	log {
		output stderr
		format json
	}

	# PLEXUS-62: an RSA certificate, as menger.sh's (DESIGN-53). The page has a
	# link preview now, and x.com's card crawler does not build the ECDSA
	# chain (EE ← YE1 ← Root YE ← X2 ← X1): it showed no card for menger.sh
	# while every other fetcher did. RSA issues on a chain that is RSA to the
	# oldest root. The edge moves the stored certificate when the type differs
	# (hypermemetic-infra: edge_cert_keys).
	tls {
		key_type rsa2048
	}

	encode zstd gzip
	root * /srv/plexus.hypermemetic.ai
	file_server

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# the page: always revalidated, so a deploy shows at once
	@page path / /index.html
	header @page Cache-Control "no-cache"

	# its assets: names are not fingerprinted, so they revalidate too — the
	# script and the page must change together
	@assets path /style.css /main.js /favicon.svg
	header @assets Cache-Control "no-cache"

	# the link preview's picture (PLEXUS-62: media/og.png, made by
	# scripts/site-preview.mjs): an hour, since a crawler keeps its own copy
	@media path /media/*
	header @media Cache-Control "public, max-age=3600"

	# the faces (Onest and Fragment Mono, both OFL, self-hosted): a day, then
	# revalidate in the background for a week
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
}
